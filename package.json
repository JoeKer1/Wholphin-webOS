{
  "name": "ember-tv",
  "version": "0.2.54",
  "private": true,
  "scripts": {
    "build:webos": "node tools/build.mjs webos",
    "build:tizen": "node tools/build.mjs tizen",
    "build": "npm run build:webos && npm run build:tizen",
    "package:webos": "node tools/package.mjs webos",
    "package:tizen": "node tools/package.mjs tizen",
    "test": "npm --prefix webos test && node --test test/*.test.cjs",
    "check": "npm --prefix webos run check"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "core-js-bundle": "^3.46.0",
    "abortcontroller-polyfill": "^1.7.8"
  }
}
