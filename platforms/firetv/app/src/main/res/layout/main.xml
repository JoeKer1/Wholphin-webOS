<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#15121C">
    <androidx.media3.ui.PlayerView android:id="@+id/native_player"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone" android:focusable="false"
        app:surface_type="texture_view" app:use_controller="false" />
    <WebView android:id="@+id/webview" android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
