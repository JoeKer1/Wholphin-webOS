<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <uses-permission android:name="com.amazon.permission.media.session.voicecommandcontrol" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>
    <application android:label="Ember" android:icon="@drawable/ember_launcher_tile"
        android:roundIcon="@drawable/ember_app_icon"
        android:logo="@drawable/ember_launcher_tile"
        android:banner="@drawable/ember_launcher_tile" android:theme="@style/AppTheme"
        android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:usesCleartextTraffic="true"
        android:supportsRtl="true" android:hardwareAccelerated="true">
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.updates"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>
        <provider android:name=".HomeSearchProvider" android:authorities="${applicationId}.search"
            android:exported="true" android:permission="android.permission.GLOBAL_SEARCH" />
        <activity android:name=".MainActivity" android:exported="true"
            android:label="Ember" android:icon="@drawable/ember_launcher_tile"
            android:banner="@drawable/ember_launcher_tile"
            android:screenOrientation="landscape" android:enableOnBackInvokedCallback="false" android:launchMode="singleTop"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="ember" android:host="title" />
            </intent-filter>
            <meta-data android:name="android.app.searchable" android:resource="@xml/home_search" />
        </activity>
        <!-- A distinct launcher component lets Fire TV register the current artwork
             while retaining the app ID, storage, signing key and update channel. -->
        <activity-alias android:name=".EmberLauncher" android:targetActivity=".MainActivity"
            android:enabled="true" android:exported="true" android:label="Ember"
            android:icon="@drawable/ember_launcher_tile" android:banner="@drawable/ember_launcher_tile">
            <meta-data android:name="android.app.default_searchable" android:value=".MainActivity" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
